{
  "name": "dsh-skin-win2000",
  "version": "1.1.0",
  "description": "Windows 2000 skin for the DSH Web GUI: metric-accurate grey chrome, two-tone gradient title bars, 1px bevels, square corners and a 16px scrollbar. 给 DSH Web GUI 换上 Windows 2000 经典外观。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness",
    "skin",
    "theme",
    "windows",
    "windows-2000",
    "win2000",
    "luna",
    "retro",
    "classic",
    "web-gui",
    "ui",
    "css"
  ],
  "meta": {
    "title": "Windows 2000 Skin",
    "description": "把 DSH Web GUI 换成 Windows 2000 经典界面：经典中性灰控件、双色渐变标题栏、1px 立体浮雕、绝对直角、16px 经典滚动条。"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lildanger/dsh-skin-win2000.git"
  },
  "homepage": "https://github.com/lildanger/dsh-skin-win2000#readme",
  "bugs": {
    "url": "https://github.com/lildanger/dsh-skin-win2000/issues"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "fonts/unsciiCJKV18.woff2",
    "fonts/README.md",
    "fonts/COPYING",
    "docs",
    "tools",
    "README.md",
    "README.en.md",
    "LICENSE",
    "HANDOFF.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
